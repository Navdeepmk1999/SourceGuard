backend/venv/
backend/__pycache__/
backend/.pytest_cache/

# graphify: graph.json is tracked (it has a merge driver in .gitattributes);
# the rendered viz, extraction cache, and interpreter sidecars are local artifacts.
graphify-out/graph.html
graphify-out/cache/
graphify-out/cost.json
graphify-out/.graphify_*
backend/.env
.DS_Store
**/__pycache__/
graphify-out/
.env

# Terraform. State is the critical one: it stores resolved secret values
# (DATABASE_URL, API keys) in PLAINTEXT, so it must never be committed. Use
# an encrypted remote backend for anything shared - see infrastructure/main.tf.
# .terraform.lock.hcl is deliberately NOT ignored: it pins provider versions
# and belongs in version control.
infrastructure/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
# Real variable values (ARNs, origins); the .example file is tracked.
terraform.tfvars
*.auto.tfvars
