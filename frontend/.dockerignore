# Installed inside the image by `npm ci` - copying the host's tree would be
# slow and can carry platform-specific binaries that don't run on Alpine.
node_modules/

# Build output - regenerated by `npm run build` in the builder stage.
.next/
out/
build/

# Secrets: NEXT_PUBLIC_* are passed as build ARGs instead (see Dockerfile),
# so the file itself never needs to enter the build context.
.env*.local
.env

# Tooling caches / logs
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-error.log*

# Editor / OS
.DS_Store
.idea/
.vscode/

# Not needed to build the app
Dockerfile
.dockerignore
README.md
